# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION FOR DUANARASI.COM
# ==============================================================================

# Database Connection (PostgreSQL)
# For Docker Compose: HOST is 'db' (postgresql://postgres:postgres@db:5432/duanarasi?schema=public)
# For Standalone VPS / PM2: HOST is 'localhost'
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/duanarasi_db?schema=public"

# Database credentials for Docker Compose container init
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="duanarasi"

# Authentication Security (Generate a random 32+ character string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-2026"

# ImgBB API Key for Dynamic Image Uploads (Logo, Article Covers, Authors)
IMGBB_API_KEY="fbe192c84a6e4a523741fb4297724951"
NEXT_PUBLIC_IMGBB_API_KEY="fbe192c84a6e4a523741fb4297724951"

# Production App URL (e.g. https://duanarasi.com)
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="production"
PORT=3000

