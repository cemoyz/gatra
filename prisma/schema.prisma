// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  role        String   @default("SUBSCRIBER") // "ADMIN" | "EDITOR" | "AUTHOR" | "SUBSCRIBER"
  designation String?  @default("Penulis") // e.g. "Pemimpin Redaksi", "Redaktur", "Jurnalis", "Penulis"
  avatar      String?  @default("/assets/img/author/author-1.webp")
  bio         String?  @db.Text
  
  // Relasi artikel yang ditulis oleh pengguna ini (One-to-Many)
  posts       Post[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

model Post {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String?    @unique
  excerpt     String?    @db.Text
  content     String?    @db.Text
  img         String?
  
  // Relasi Kategori (Many-to-One)
  categoryId  Int?
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Relasi Penulis / Redaksi (Many-to-One, terhubung langsung ke User)
  authorId    Int?
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  editorName  String?    // Nama Editor / Penyunting berita

  // Relasi Tag (Many-to-Many)
  tags        Tag[]      @relation("PostTags")

  // Relasi Komentar (One-to-Many)
  comments    Comment[]

  views       Int        @default(0)
  status      String     @default("PUBLISHED") // "PUBLISHED" | "DRAFT"
  featured    Boolean    @default(false)
  
  // Post Types: standard | video | audio | gallery | quote | link | status
  postType    String     @default("standard")
  
  // Format specific fields
  videoUrl    String?
  audioUrl    String?
  quoteText   String?    @db.Text
  quoteAuthor String?
  externalUrl String?
  gallery     String?    @db.Text
  layout      String?    @default("right-sidebar") // right-sidebar | left-sidebar | no-sidebar | info-right | compact

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("posts")
}

model Category {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  slug         String   @unique
  description  String?  @db.Text
  showInHeader Boolean  @default(true)
  posts        Post[]
  createdAt    DateTime @default(now())

  @@map("categories")
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  posts     Post[]   @relation("PostTags")
  createdAt DateTime @default(now())

  @@map("tags")
}

model Comment {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  content   String   @db.Text
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("comments")
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text

  @@map("settings")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  status    String   @default("UNREAD") // "UNREAD" | "READ" | "REPLIED"
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  topics    String?  @default("Semua Topik")
  frequency String?  @default("weekly")
  status    String   @default("ACTIVE") // "ACTIVE" | "UNSUBSCRIBED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscribers")
}
